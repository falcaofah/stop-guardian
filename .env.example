# Your DreamDEX account (the address shown in the app).
OWNER_ADDRESS=
# A key linked in the app (wallet > Link a bot > Perps). It can trade but cannot withdraw.
# Leave blank to only watch and alert. Never use your main wallet key.
PRIVATE_KEY=
# true: says what it would do and sends nothing. Set false to let it close positions.
DRY_RUN=true
# Optional. From @BotFather, and your own chat id. Without them, messages go to the console.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# How often to check, in milliseconds.
POLL_MS=3000
